generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator prismabox {
  provider                    = "prismabox"
  output                      = "../src/generated/prismabox"
  additionalProperties        = "true"
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id       String           @id @default(cuid())
  resource String
  action   String
  roles    RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id                  String                @id @default(cuid())
  name                String
  email               String                @unique
  emailVerified       Boolean               @default(false)
  image               String?
  isAnonymous         Boolean?              @default(false)
  createdAt           DateTime?             @default(now())
  updatedAt           DateTime?             @updatedAt
  deletedAt           DateTime?
  accounts            Account[]
  LetterInstance      LetterInstance[]
  mahasiswa           Mahasiswa?
  pegawai             Pegawai?
  riwayatPengajuanSkl RiwayatPengajuanSkl[]
  sessions            Session[]
  userRole            UserRole[]

  @@map("user")
}

model Mahasiswa {
  id             String         @id @default(cuid())
  nim            String
  tahunMasuk     String
  noHp           String
  alamat         String?
  tempatLahir    String?
  tanggalLahir   DateTime?
  userId         String         @unique
  departemenId   String
  programStudiId String
  departemen     Departemen     @relation(fields: [departemenId], references: [id])
  programStudi   ProgramStudi   @relation(fields: [programStudiId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  pengajuanSkl   PengajuanSkl[]

  @@map("mahasiswa")
}

model Pegawai {
  id                       String         @id @default(cuid())
  nip                      String
  jabatan                  String
  noHp                     String?
  userId                   String         @unique
  departemenId             String
  programStudiId           String
  createdAt                DateTime?      @default(now())
  updatedAt                DateTime?      @updatedAt
  deletedAt                DateTime?
  departemen               Departemen     @relation(fields: [departemenId], references: [id])
  programStudi             ProgramStudi   @relation("PegawaiProgramStudi", fields: [programStudiId], references: [id])
  user                     User           @relation(fields: [userId], references: [id])
  pengajuanSklAsAdminProdi PengajuanSkl[] @relation("AdminProdiPengajuan")
  pengajuanSklAsUPA        PengajuanSkl[] @relation("UPAPengajuan")
  ketuaDiProgramStudi      ProgramStudi[] @relation("KetuaProgramStudi")

  @@map("pegawai")
}

model Departemen {
  id           String         @id @default(cuid())
  name         String
  code         String         @unique
  createdAt    DateTime?      @default(now())
  updatedAt    DateTime?      @updatedAt
  deletedAt    DateTime?
  mahasiswa    Mahasiswa[]
  pegawai      Pegawai[]
  programStudi ProgramStudi[]

  @@map("departemen")
}

model ProgramStudi {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  departemenId String
  createdAt    DateTime?   @default(now())
  updatedAt    DateTime?   @updatedAt
  deletedAt    DateTime?
  ketuaProdiId String?
  mahasiswa    Mahasiswa[]
  pegawai      Pegawai[]   @relation("PegawaiProgramStudi")
  departemen   Departemen  @relation(fields: [departemenId], references: [id])
  ketuaProdi   Pegawai?    @relation("KetuaProgramStudi", fields: [ketuaProdiId], references: [id])

  @@map("program_studi")
}

model Attachment {
  id        String    @id @default(cuid())
  domain    String
  filename  String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  @@map("attachment")
}

model LetterType {
  id             String           @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime?        @default(now())
  updatedAt      DateTime?        @updatedAt
  deletedAt      DateTime?
  letterInstance LetterInstance[]
  templates      LetterTemplate[]

  @@map("letter_type")
}

model LetterTemplate {
  id               String     @id @default(cuid())
  versionName      String     @map("version_name")
  schemaDefinition Json       @map("schema_defintion")
  formFields       Json       @map("form_fields")
  letterTypeId     String     @map("letter_type_id")
  LetterType       LetterType @relation(fields: [letterTypeId], references: [id])

  @@map("letter_template")
}

model LetterInstance {
  id           String       @id @default(cuid())
  schema       Json
  values       Json
  status       LetterStatus @default(PENDING)
  currentStep  Int?
  letterTypeId String
  createdById  String
  createdAt    DateTime     @default(now())
  createdBy    User         @relation(fields: [createdById], references: [id])
  letterType   LetterType   @relation(fields: [letterTypeId], references: [id])

  @@map("letter_instance")
}

model PengajuanSkl {
  id                    String                @id @default(cuid())
  mahasiswaId           String
  tglLulus              DateTime
  ipkTerakhir           Float
  nomorSuratPengantar   String?
  adminProdiId          String?
  nomorSkl              String?
  pegawaiUpaId          String?
  status                StatusPengajuan       @default(DRAFT)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  alamatSementara       String?
  emailSementara        String?
  namaSementara         String?
  noHpSementara         String?
  tandatangan           String?
  tanggalLahirSementara DateTime?
  tempatLahirSementara  String?
  ttdKetuaProdi         String?
  pdfFinalPath          String?
  departemenSementara   String?
  jumlahSks             Int                   @default(0)
  nimSementara          String?
  prodiSementara        String?
  lampiran              LampiranSkl[]
  adminProdi            Pegawai?              @relation("AdminProdiPengajuan", fields: [adminProdiId], references: [id])
  mahasiswa             Mahasiswa             @relation(fields: [mahasiswaId], references: [id])
  pegawaiUpa            Pegawai?              @relation("UPAPengajuan", fields: [pegawaiUpaId], references: [id])
  riwayat               RiwayatPengajuanSkl[]

  @@map("pengajuan_skl")
}

model RiwayatPengajuanSkl {
  id             String          @id @default(cuid())
  pengajuanSklId String
  actorId        String
  statusBaru     StatusPengajuan
  catatan        String?
  timestamp      DateTime        @default(now())
  actor          User            @relation(fields: [actorId], references: [id])
  pengajuanSkl   PengajuanSkl    @relation(fields: [pengajuanSklId], references: [id])

  @@map("riwayat_pengajuan_skl")
}

model LampiranSkl {
  id             String           @id @default(cuid())
  pengajuanSklId String
  jenisDokumen   JenisLampiranSkl
  pathFile       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  namaFile       String           @default("")
  pengajuanSkl   PengajuanSkl     @relation(fields: [pengajuanSklId], references: [id])

  @@map("lampiran_skl")
}

enum Jenjang {
  S1
  S2
  S3
}

enum FieldType {
  STRING
  NUMBER
  DATE
  FILE
  BOOLEAN
  ENUM

  @@map("field_type")
}

enum LetterStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED

  @@map("letter_status")
}

enum StepStatus {
  DRAFT
  ACCEPTED
  VERIFIED
  REJECTED
  REVISION

  @@map("step_status")
}

enum TemplateEngine {
  HANDLEBARS
  RAW

  @@map("template_engine")
}

enum StatusPengajuan {
  DRAFT
  SUBMITTED
  REVISI
  VERIFIED_ADMIN
  APPROVED_KAPRODI
  REGISTERED
  SIAP_CETAK
  COMPLETED
  REGISTERING
  APPROVED_SUPERVISOR
  STEP_KONVENSIONAL
  DITOLAK
  BATAL

  @@map("status_pengajuan")
}

enum JenisLampiranSkl {
  KTM
  TRANSKRIP_NILAI
  BERITA_ACARA_UJIAN
  BEBAS_PUSTAKA
  PAS_FOTO
  LAINNYA
  BUKTI_SUBMIT

  @@map("jenis_lampiran_skl")
}
